# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored by `.env*`).
# Values come from Supabase > Project Settings. Ask the project owner; do not paste them in chat.

# Public (shipped to the browser; protected by RLS, not secret by design)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never log, never send to a client.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres. Pooler (6543) for the app, direct (5432) for migrations. URL-encode the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Comma-separated extra origins allowed to POST to /api and open the LAN relay (production domain).
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional (local prototype server)
# PORT=3000
# HTTPS_PORT=3443

# HACKATHON: nurse self sign-up is open. Set to "closed" before real use.
# STAFF_SIGNUP=closed
